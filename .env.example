# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Local browser testing only. These flags route Firebase Auth and Firestore to
# local emulators and expose a deterministic test sign-in button.
VITE_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_TEST_AUTH=false
VITE_TEST_AUTH_EMAIL="player@example.test"
VITE_TEST_AUTH_PASSWORD="politipick-test-password"
VITE_TEST_AUTH_DISPLAY_NAME="Test Player"

# Optional local UI data fallback.
VITE_USE_MOCK_CONTESTS=false

# --- Data pipeline keys (all free) ---
# Congress.gov API — structured legislative facts for candidate research.
# Sign up: https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=""
# FEC API (api.data.gov) — 2026 federal candidate filings. DEMO_KEY works for smoke tests.
# Sign up: https://api.data.gov/signup/
FEC_API_KEY=""
# Census API — ACS demographics + turnout denominators for contest metrics.
# Sign up: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=""
# OpenStates v3 API — state legislative bills for the PIP-S State Tab.
# Sign up: https://openstates.org/accounts/signup/
OPENSTATES_API_KEY=""
# Optional: override the Gemini model used by all enrichment scripts.
GEMINI_MODEL="gemini-2.5-flash"
