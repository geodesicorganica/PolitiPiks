rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    match /test/connection {
      allow read: if true;
    }

    // --- Users ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.photoURL is string && data.photoURL.size() <= 2000 &&
             data.totalPoints is number && data.totalPoints >= 0 &&
             data.predictionsCount is number && data.predictionsCount >= 0 &&
             data.correctPredictions is number && data.correctPredictions >= 0 &&
             data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'totalPoints', 'predictionsCount', 'correctPredictions']) &&
             data.keys().size() == 7;
    }

    function isValidUserPublic(data) {
      return data.displayName is string && data.displayName.size() <= 100 &&
             data.photoURL is string && data.photoURL.size() <= 2000 &&
             data.totalPoints is number && data.totalPoints >= 0 &&
             data.predictionsCount is number && data.predictionsCount >= 0 &&
             data.correctPredictions is number && data.correctPredictions >= 0 &&
             data.keys().hasAll(['displayName', 'photoURL', 'totalPoints', 'predictionsCount', 'correctPredictions']) &&
             data.keys().size() == 5;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL']);
    }

    match /users_public/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUserPublic(incoming());
      allow update: if isOwner(userId) && isValidUserPublic(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /users_private/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- Leagues ---
    function isValidLeague(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.ownerId == request.auth.uid &&
             data.inviteCode is string && data.inviteCode.size() <= 10 &&
             data.createdAt == request.time &&
             data.electionYear == 2026 &&
             data.mode == 'live' &&
             data.keys().hasAll(['name', 'ownerId', 'inviteCode', 'createdAt', 'electionYear', 'mode']) &&
             data.keys().size() == 6;
    }

    function isValidMember(data) {
      return data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.photoURL is string && data.photoURL.size() <= 500 &&
             data.points == 0 && data.joinedAt == request.time &&
             data.keys().hasAll(['userId', 'displayName', 'photoURL', 'points', 'joinedAt']) &&
             data.keys().size() == 5;
    }

    function isLiveLeague(leagueId) {
      return isValidId(leagueId) &&
             exists(/databases/$(database)/documents/leagues/$(leagueId)) &&
             get(/databases/$(database)/documents/leagues/$(leagueId)).data.electionYear == 2026 &&
             get(/databases/$(database)/documents/leagues/$(leagueId)).data.mode == 'live';
    }

    function isLeagueMember(leagueId) {
      return isLiveLeague(leagueId) &&
             exists(/databases/$(database)/documents/leagues/$(leagueId)/members/$(request.auth.uid));
    }

    function hasOnlyEditableLeagueFields() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['name', 'inviteCode']) &&
             incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
             incoming().inviteCode is string && incoming().inviteCode.size() > 0 && incoming().inviteCode.size() <= 10;
    }

    match /leagues/{leagueId} {
      allow get: if isSignedIn() && isValidId(leagueId);
      allow list: if isSignedIn(); // Broad list needed for joining by invite code
      allow create: if isSignedIn() && isValidLeague(incoming());
      allow update: if isSignedIn() && isValidId(leagueId) &&
        resource.data.ownerId == request.auth.uid && hasOnlyEditableLeagueFields();
      
      match /members/{memberId} {
        allow get: if isSignedIn() && isValidId(memberId);
        allow list: if isSignedIn();
        allow create: if isOwner(memberId) && isValidId(memberId) &&
          incoming().userId == memberId && isLiveLeague(leagueId) && isValidMember(incoming());
        allow update, delete: if false;
      }
    }

    match /races/{raceId} {
      allow read: if isSignedIn();

      match /candidateResearch/{candidateId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /ballotMeasures/{measureId} {
      allow read: if isSignedIn();
    }

    match /contestMetrics/{raceId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /catalogActivations/{activationId} {
      allow read: if isSignedIn() && activationId == 'canonical-2026';
      allow write: if false;
    }

    function isFederalRaceId(targetId) {
      return targetId is string &&
        targetId.matches('^2026-[A-Z]{2}-(senate(-(special-)?class-[123])?|house-[0-9]{3})$');
    }

    function catalogSelectorExists() {
      return exists(/databases/$(database)/documents/catalogActivations/canonical-2026);
    }

    function activeFederalGeneration() {
      return get(/databases/$(database)/documents/catalogActivations/canonical-2026).data.activeFederalGeneration;
    }

    function catalogSelectorIsUsable() {
      return catalogSelectorExists() &&
        (get(/databases/$(database)/documents/catalogActivations/canonical-2026).data.state == 'active' ||
         get(/databases/$(database)/documents/catalogActivations/canonical-2026).data.state == 'rollback') &&
        activeFederalGeneration() is string;
    }

    function activeFederalRaceTarget(targetId) {
      return exists(/databases/$(database)/documents/races/$(targetId)) &&
        (
          (!catalogSelectorExists() &&
            get(/databases/$(database)/documents/races/$(targetId)).data.get('registryGeneration', null) == null) ||
          (catalogSelectorIsUsable() && activeFederalGeneration() == 'legacy-2026' &&
            get(/databases/$(database)/documents/races/$(targetId)).data.get('registryGeneration', null) == null) ||
          (catalogSelectorIsUsable() && activeFederalGeneration() != 'legacy-2026' &&
            get(/databases/$(database)/documents/races/$(targetId)).data.get('catalogScope', null) == 'federal' &&
            get(/databases/$(database)/documents/races/$(targetId)).data.get('registryGeneration', null) == activeFederalGeneration())
        );
    }

    function liveTargetIsOpen(data) {
      return (data.type == 'race' &&
              exists(/databases/$(database)/documents/races/$(data.targetId)) &&
              get(/databases/$(database)/documents/races/$(data.targetId)).data.electionYear == 2026 &&
              get(/databases/$(database)/documents/races/$(data.targetId)).data.mode == 'live' &&
              get(/databases/$(database)/documents/races/$(data.targetId)).data.closeAt is timestamp &&
              (!isFederalRaceId(data.targetId) || activeFederalRaceTarget(data.targetId)) &&
              request.time < get(/databases/$(database)/documents/races/$(data.targetId)).data.closeAt) ||
             (data.type == 'measure' &&
              exists(/databases/$(database)/documents/ballotMeasures/$(data.targetId)) &&
              get(/databases/$(database)/documents/ballotMeasures/$(data.targetId)).data.electionYear == 2026 &&
              get(/databases/$(database)/documents/ballotMeasures/$(data.targetId)).data.mode == 'live' &&
              get(/databases/$(database)/documents/ballotMeasures/$(data.targetId)).data.closeAt is timestamp &&
              request.time < get(/databases/$(database)/documents/ballotMeasures/$(data.targetId)).data.closeAt);
    }

    function isValidPredictionCreate(data) {
      return data.keys().hasAll(['userId', 'leagueId', 'targetId', 'type', 'pick', 'status', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'leagueId', 'targetId', 'type', 'pick', 'status', 'createdAt', 'updatedAt']) &&
             data.userId == request.auth.uid &&
             data.leagueId is string && isValidId(data.leagueId) &&
             data.targetId is string && isValidId(data.targetId) &&
             data.type in ['race', 'measure'] &&
             data.pick is string && data.pick.size() > 0 && data.pick.size() <= 128 &&
             data.status == 'pending' &&
             data.createdAt == request.time &&
             (!data.keys().hasAny(['updatedAt']) || data.updatedAt == request.time);
    }

    function isValidPredictionUpdate() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['pick', 'updatedAt']) &&
             incoming().pick is string && incoming().pick.size() > 0 && incoming().pick.size() <= 128 &&
             incoming().keys().hasAll(['updatedAt']) && incoming().updatedAt == request.time;
    }

    match /predictions/{predictionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid &&
        isLeagueMember(resource.data.leagueId);
      allow create: if isSignedIn() && isValidPredictionCreate(incoming()) &&
        isLeagueMember(incoming().leagueId) && liveTargetIsOpen(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        isLeagueMember(resource.data.leagueId) && liveTargetIsOpen(resource.data) && isValidPredictionUpdate();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid &&
        isLeagueMember(resource.data.leagueId) && liveTargetIsOpen(resource.data);
    }
  }
}
