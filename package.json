{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "verify-deployment-readiness": "tsx scripts/verify-deployment-readiness.ts",
    "grant-admin": "tsx scripts/grant-admin.ts",
    "emulators": "firebase emulators:start --only auth,firestore",
    "seed-2024": "npm --prefix ingest run seed:2024",
    "seed-2026-federal": "npm --prefix ingest run seed:fec",
    "seed-2026-curated": "npm --prefix ingest run seed:file -- --file ../data/2026/curated-contests.json",
    "prune-invalid-federal-races": "tsx scripts/prune-invalid-federal-races.ts",
    "clear-2026-mock-contests": "tsx scripts/clear-2026-mock-contests.ts",
    "enrich-research": "tsx scripts/enrich-research.ts",
    "enrich-research-2024": "tsx scripts/enrich-research-2024.ts",
    "discover-sources-2024": "tsx scripts/discover-sources-2024.ts",
    "seed-pips-data": "tsx scripts/seed-pips-data.ts",
    "build-contest-metrics": "tsx scripts/build-contest-metrics.ts",
    "link-external-ids": "tsx scripts/link-external-ids.ts",
    "enrich-structured": "tsx scripts/enrich-structured.ts",
    "enrich-fec-finance": "tsx scripts/enrich-fec-finance.ts",
    "test-fec-finance": "tsx scripts/lib/fecFinance.test.ts",
    "test-contest-metrics": "tsx scripts/lib/contestMetrics.test.ts",
    "enrich-roll-calls": "tsx scripts/enrich-roll-calls.ts",
    "test-roll-calls": "tsx scripts/lib/rollCalls.test.ts",
    "test-ingest-free-sources": "tsx ingest/src/sources/freeSources.test.ts",
    "test-free-sources": "npm run test-fec-finance && npm run test-contest-metrics && npm run test-roll-calls && npm run test-ingest-free-sources && npm run verify-contests-logic",
    "discover-2026-contests": "tsx scripts/discover-2026-contests.ts",
    "ingest-bills": "tsx scripts/ingest-bills.ts",
    "verify-firestore-league-flow": "firebase emulators:exec --only firestore \"tsx scripts/verify-firestore-league-flow.ts\"",
    "verify-browser-league-flow": "firebase emulators:exec --only auth,firestore \"playwright test\"",
    "verify-league-flow": "tsx scripts/verify-league-flow.ts",
    "verify-contests": "tsx scripts/verify-contests.ts",
    "report-canonical-2026-migration": "tsx scripts/report-canonical-2026-migration.ts",
    "report-canonical-2026-publication": "tsx scripts/report-canonical-2026-publication.ts",
    "audit-canonical-2026-publication": "tsx scripts/audit-canonical-2026-publication.ts",
    "audit-2026-deadline-registry": "tsx scripts/audit-2026-deadline-registry.ts",
    "test-canonical-publication": "tsx scripts/lib/canonicalPublication.test.ts",
    "test-deadline-registry": "tsx scripts/lib/deadlineRegistry.test.ts",
    "test-canonical-publication-cli": "tsx scripts/lib/canonicalPublicationCli.test.ts",
    "test-ballot-eligibility": "tsx scripts/lib/ballotEligibility.test.ts && tsx scripts/lib/gaBallotEligibilityAdapter.test.ts && tsx scripts/lib/ballotEligibilityCli.test.ts",
    "test-ballot-measures": "tsx scripts/lib/canonicalBallotMeasures.test.ts",
    "test-state-source-registry": "tsx scripts/lib/stateElectionSourceRegistry.test.ts",
    "test-wave-b-state-providers": "tsx scripts/lib/waveBStateProviders.test.ts",
    "test-wave-c-pdf-providers": "tsx scripts/lib/waveCPdfProviders.test.ts",
    "test-wave-d-source-resolution": "tsx scripts/lib/waveDSourceResolution.test.ts",
    "test-wave-d-state-providers": "tsx scripts/lib/waveDStateProviders.test.ts",
    "test-research-metrics-baseline": "tsx scripts/lib/researchMetricsBaseline.test.ts && tsx scripts/lib/researchMetricsBaselineCli.test.ts",
    "report-2026-research-metrics-baseline": "tsx scripts/report-2026-research-metrics-baseline.ts",
    "audit-2026-state-source-registry": "tsx scripts/audit-2026-state-election-source-registry.ts",
    "audit-2026-wave-d-source-resolution": "tsx scripts/audit-2026-wave-d-source-resolution.ts",
    "audit-2026-wave-d-state-providers": "tsx scripts/audit-2026-wave-d-state-providers.ts",
    "report-2026-statewide-ballot-measures": "tsx scripts/report-2026-statewide-ballot-measures.ts",
    "report-2026-ballot-eligibility": "tsx scripts/report-2026-ballot-eligibility.ts",
    "apply-canonical-shadow": "tsx scripts/apply-canonical-shadow.ts",
    "test-canonical-shadow-executor": "tsx scripts/lib/canonicalShadowExecutor.test.ts",
    "test-canonical-shadow-executor-emulator": "firebase emulators:exec --config scripts/firebase.emulator-test.json --only firestore \"tsx scripts/lib/canonicalShadowExecutor.emulator.test.ts\"",
    "test-canonical-activation": "tsx scripts/lib/canonicalActivation.test.ts && tsx scripts/lib/canonicalActivationCli.test.ts",
    "test-canonical-activation-emulator": "firebase emulators:exec --config scripts/firebase.emulator-test.json --only firestore \"tsx scripts/lib/canonicalActivation.emulator.test.ts\"",
    "test-canonical-federal-registry": "tsx ingest/src/federalRegistry.test.ts",
    "test-canonical-shadow-migration": "tsx scripts/lib/canonicalMigration.test.ts",
    "verify-contests-logic": "tsx scripts/verify-contests-logic.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-force-graph-2d": "^1.29.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.60.0",
    "@types/diff": "^7.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.3.0",
    "firebase-tools": "^15.19.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
