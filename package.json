{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:rules": "eslint firestore.rules",
    "grant-admin": "tsx scripts/grant-admin.ts",
    "emulators": "firebase emulators:start --only auth,firestore",
    "seed-2024": "npm --prefix ingest run seed:2024",
    "clear-2026-mock-contests": "tsx scripts/clear-2026-mock-contests.ts",
    "enrich-research-2024": "tsx scripts/enrich-research-2024.ts",
    "verify-firestore-league-flow": "firebase emulators:exec --only firestore \"tsx scripts/verify-firestore-league-flow.ts\"",
    "verify-browser-league-flow": "firebase emulators:exec --only auth,firestore \"playwright test\"",
    "verify-league-flow": "tsx scripts/verify-league-flow.ts",
    "verify-contests": "tsx scripts/verify-contests.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.3.0",
    "firebase-tools": "^15.19.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
