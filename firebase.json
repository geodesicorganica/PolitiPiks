{
  "firestore": [
    {
      "database": "ai-studio-politipickmidter-cead0e40-d220-401c-9ce8-1d4e5901d29a",
      "rules": "firestore.rules"
    }
  ],
  "hosting": {
    "site": "politipiks",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    }
  }
}
